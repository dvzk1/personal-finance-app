# Copie para .env e preencha. NUNCA commite o .env preenchido nem o credentials.json.

# ---- Banco de dados ---------------------------------------------------------
# Sem SHEET_ID, o app usa um arquivo SQLite local, criado sozinho na pasta de dados do
# usuário (macOS: ~/Library/Application Support/finance-control/finance.db; Linux:
# ~/.local/share/finance-control/finance.db; Windows: %APPDATA%\finance-control\finance.db).
# FINANCE_DB aponta para outro arquivo. FINANCE_BACKEND=sqlite|sheets força a escolha.
FINANCE_DB=
FINANCE_BACKEND=

# ---- Google Sheets (opcional: banco na nuvem) -------------------------------
# ID da planilha que VOCÊ criou e compartilhou com o e-mail da Service Account.
# Está na URL: https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=

# Caminho do JSON da Service Account (baixado do Google Cloud). Default: ./credentials.json
GOOGLE_SA_CREDENTIALS=credentials.json

# ---- Cotações (só no banco local; na planilha quem cota é o GOOGLEFINANCE) --
# Sem chave nenhuma, B3, EUA e cripto vêm do Yahoo Finance e o dólar do Banco Central.
# Token grátis da brapi.dev (https://brapi.dev/dashboard): com ele, a B3 vem da brapi.
BRAPI_TOKEN=
# Ordem de tentativa por tipo, sobrescrevendo o padrão. Tipos: stock_br, fii_br, stock_us,
# crypto, fx. Provedores: yahoo, brapi, bcb. Ex.: QUOTE_PROVIDERS=stock_br=yahoo;fx=yahoo
QUOTE_PROVIDERS=

# ---- Credenciais da Pluggy (https://dashboard.pluggy.ai) --------------------
CLIENT_ID=seu_client_id_aqui
CLIENT_SECRET=seu_client_secret_aqui

# IDs dos "items" (conexões) conectados via Pluggy Connect / Meu Pluggy.
# Separados por vírgula. Ex.: ITEM_IDS=uuid-1,uuid-2
ITEM_IDS=

# ---- Servidor (finance/server.py; detalhes em docs/SERVER.md) ----------------
# FINANCE_PORT=5273
# Para abrir de outro aparelho pela rede privada (Tailscale): o endereço e uma senha.
# FINANCE_HOST=100.x.y.z
# FINANCE_TOKEN=
# Sincronização com a Pluggy feita pelo próprio servidor, logo depois da Pluggy atualizar.
# FINANCE_SYNC_SCHEDULE=1
# FINANCE_SYNC_HOURS=6
